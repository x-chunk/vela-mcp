# Keep .env private (chmod 600). Existing OS env variables take precedence.
VELA_URL=http://127.0.0.1:8080
VELA_TOKEN=replace-with-your-vela-rw-key
# HTTP connector mode does not use VELA_TOKEN: enter your key on the OAuth page.
# VELA_MCP_TRANSPORT=http
# VELA_MCP_LISTEN=127.0.0.1:8081
# VELA_MCP_ISSUER=https://mcp.example.org
# VELA_MCP_OAUTH_DATABASE=/absolute/private/data/oauth.db
# VELA_MCP_ENCRYPTION_KEY_FILE=/absolute/private/data/encryption.key
# VELA_MCP_TRANSFER_DATABASE=/absolute/private/data/transfers.db
# Optional alternative paths; relative paths use the process working directory.
# VELA_MCP_CONFIG=/absolute/path/config.toml
# VELA_MCP_ENV_FILE=/absolute/path/.env
