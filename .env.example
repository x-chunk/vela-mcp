# Keep .env private (chmod 600). Existing OS env variables take precedence.
VELA_URL=http://127.0.0.1:8080
VELA_TOKEN=replace-with-your-vela-rw-key
# Optional alternative paths; relative paths use the process working directory.
# VELA_MCP_CONFIG=/absolute/path/config.toml
# VELA_MCP_ENV_FILE=/absolute/path/.env
